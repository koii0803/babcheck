---
import { catName, catImage, fmtDate } from '../site';
const { post, featured = false } = Astro.props;
const d = post.data;
const name = catName(d.category);
const img = d.thumbnail || catImage(d.category);
const href = `/posts/${post.id}`;
---
{featured ? (
  <a href={href} class="card group grid overflow-hidden md:grid-cols-[1.15fr_1fr]">
    <div class="thumb-fallback aspect-video md:aspect-auto md:min-h-[340px] overflow-hidden">
      {img && <img src={img} alt="" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" loading="eager" />}
    </div>
    <div class="flex flex-col justify-center p-7 md:p-10">
      <p class="eyebrow">{name}</p>
      <h2 class="serif mt-3 text-[1.7rem] font-bold leading-[1.3] group-hover:text-moss md:text-[2rem]">{d.title}</h2>
      {d.description && <p class="mt-4 line-clamp-3 text-[1.02rem] leading-relaxed text-ink-2">{d.description}</p>}
      <p class="mt-6 text-sm text-ink-3"><time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time></p>
    </div>
  </a>
) : (
  <a href={href} class="card group flex flex-col overflow-hidden">
    <div class="thumb-fallback aspect-video overflow-hidden">
      {img && <img src={img} alt="" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" loading="lazy" />}
    </div>
    <div class="flex flex-1 flex-col p-6">
      <p class="eyebrow">{name}</p>
      <h3 class="serif mt-2.5 text-[1.2rem] font-bold leading-snug group-hover:text-moss">{d.title}</h3>
      {d.description && <p class="mt-3 line-clamp-2 text-[0.95rem] leading-relaxed text-ink-2">{d.description}</p>}
      <p class="mt-auto pt-5 text-xs text-ink-3"><time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time></p>
    </div>
  </a>
)}
