---
import { catName, catImage, fmtDate } from '../site';
const { post } = Astro.props;
const d = post.data;
const name = catName(d.category);
const img = d.thumbnail || catImage(d.category);
---
<a href={`/posts/${post.id}`} class="card group flex flex-col overflow-hidden">
  <div class="thumb-fallback aspect-[4/3] overflow-hidden">
    {img && <img src={img} alt="" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]" loading="lazy" transition:name={`post-img-${post.id}`} />}
  </div>
  <div class="flex flex-1 flex-col p-3.5 md:p-5">
    <p class="eyebrow">{name}</p>
    <h3 class="serif mt-1.5 line-clamp-2 break-keep text-[1rem] font-bold leading-snug group-hover:text-moss md:text-[1.15rem]" transition:name={`post-title-${post.id}`}>{d.title}</h3>
    <p class="mt-auto pt-3 text-[11px] text-ink-3 md:text-xs"><time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time></p>
  </div>
</a>
