---
import { render } from 'astro:content';
import { getPublished } from '../../lib/posts';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE, catName, catImage, fmtDate } from '../../site';
export async function getStaticPaths() {
  const posts = await getPublished();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, related: posts.filter((p) => p.id !== post.id && p.data.category === post.data.category).slice(0, 3) },
  }));
}
const { post, related } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const name = catName(d.category);
const heroImg = d.thumbnail || catImage(d.category);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  ...(d.updatedDate && { dateModified: d.updatedDate.toISOString() }),
  ...(d.thumbnail && { image: new URL(d.thumbnail, Astro.site).toString() }),
  author: { '@type': 'Organization', name: SITE.title },
  publisher: { '@type': 'Organization', name: SITE.title },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---
<Base title={d.title} description={d.description} image={d.thumbnail} type="article" pubDate={d.pubDate} updatedDate={d.updatedDate}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <header class="mx-auto max-w-3xl px-5 pt-14 md:pt-20">
    <a href={`/category/${d.category}`} class="eyebrow hover:underline">{name}</a>
    <h1 class="serif mt-4 break-keep text-[1.9rem] font-bold leading-[1.25] md:text-[2.7rem]" transition:name={`post-title-${post.id}`}>{d.title}</h1>
    {d.description && <p class="mt-5 text-lg leading-relaxed text-ink-2">{d.description}</p>}
    <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-line pt-5 text-sm text-ink-3">
      <span>{SITE.title}</span>
      <span aria-hidden="true">·</span>
      <time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time>
      {d.updatedDate && <><span aria-hidden="true">·</span><span>수정 {fmtDate(d.updatedDate)}</span></>}
    </div>
  </header>

  {heroImg && (
    <figure class="mx-auto mt-8 max-w-4xl px-5 md:mt-10">
      <img src={heroImg} alt={d.title} class="aspect-[16/9] w-full rounded-2xl border border-line object-cover" loading="eager" transition:name={`post-img-${post.id}`} />
    </figure>
  )}

  <div class="mx-auto max-w-3xl px-5 pt-8">
    <article class="article">
      <Content />
    </article>
  </div>

  {d.tags.length > 0 && (
    <nav class="mx-auto mt-10 max-w-3xl px-5">
      <ul class="flex flex-wrap gap-2">
        {d.tags.map((t) => <li><a href={`/tag/${t}`} class="inline-block rounded-full border border-line bg-card px-3 py-1 text-xs text-ink-2 hover:border-moss hover:text-moss">#{t}</a></li>)}
      </ul>
    </nav>
  )}

  <aside class="mx-auto mt-10 max-w-3xl px-5">
    <div class="rounded-2xl border border-line bg-card px-6 py-5 text-sm leading-relaxed text-ink-2">
      이 글은 일반 정보 제공 목적이며 진단·치료·처방을 대신하지 않습니다. 질병이 있거나 약을 복용 중이면 식단을 바꾸기 전에 의사·약사와 상담하세요.
    </div>
  </aside>

  {related.length > 0 && (
    <section class="mx-auto mt-20 max-w-6xl px-5">
      <h2 class="serif mb-6 text-2xl font-bold">같이 볼 글</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}
</Base>
