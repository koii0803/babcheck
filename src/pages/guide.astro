---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CategoryStrip from '../components/CategoryStrip.astro';
import { SITE, CATEGORIES } from '../site';
// 대도감(허브) 페이지. 본문 원고는 사용자가 채운다.
const posts = await getCollection('posts', ({ data }) => !data.draft);
const counts = posts.reduce((m, p) => ((m[p.data.category] = (m[p.data.category] ?? 0) + 1), m), {} as Record<string, number>);
const byCat = (slug: string) =>
  posts.filter((p) => p.data.category === slug).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);
---
<Base title="대도감" description="제철 수산물과 천연 식재료를 다섯 갈래로 나눠 안내합니다." image={SITE.ogImage}>
  <section class="mx-auto max-w-6xl px-5 pt-10 md:pt-20">
    <p class="eyebrow">Guide</p>
    <h1 class="serif mt-3 break-keep text-[2rem] font-bold leading-tight md:text-[2.9rem]">대도감</h1>
    <p class="mt-4 max-w-2xl text-[1.02rem] leading-relaxed text-ink-2 md:text-lg">제철 수산물과 천연 식재료를 다섯 갈래로 나눴습니다. 궁금한 쪽을 고르세요.</p>
    <div class="mt-8">
      <CategoryStrip counts={counts} />
    </div>
  </section>

  <!-- PC 상세 카드 -->
  <section class="mx-auto mt-12 hidden max-w-6xl space-y-6 px-5 md:block">
    {Object.entries(CATEGORIES).map(([slug, c], i) => {
      const list = byCat(slug);
      return (
        <div class="card grid overflow-hidden md:grid-cols-[2fr_3fr]">
          <a href={`/category/${slug}`} class="relative block aspect-video overflow-hidden md:aspect-auto">
            <img src={c.image} alt="" class="h-full w-full object-cover" loading="lazy" />
          </a>
          <div class="p-7 md:p-9">
            <p class="eyebrow">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="serif mt-2 text-2xl font-bold"><a href={`/category/${slug}`} class="hover:text-moss">{c.name}</a></h2>
            <p class="mt-3 leading-relaxed text-ink-2">{c.desc}</p>
            {list.length > 0 ? (
              <ul class="mt-5 space-y-2 border-t border-line pt-5 text-[0.95rem]">
                {list.map((p) => <li><a href={`/posts/${p.id}`} class="text-ink hover:text-moss">{p.data.title}</a></li>)}
              </ul>
            ) : (
              <p class="mt-5 border-t border-line pt-5 text-sm text-ink-3">준비 중입니다.</p>
            )}
            <a href={`/category/${slug}`} class="mt-5 inline-block text-sm font-semibold text-moss hover:underline">{c.name} 전체 보기 →</a>
          </div>
        </div>
      );
    })}
  </section>

  <!-- 모바일: 분류별 한 줄 설명 -->
  <section class="mx-auto mt-8 max-w-6xl space-y-2 px-5 md:hidden">
    {Object.entries(CATEGORIES).map(([slug, c]) => (
      <a href={`/category/${slug}`} class="card flex items-center gap-3 p-3">
        <img src={c.image} alt="" class="h-12 w-12 shrink-0 rounded-xl object-cover" loading="lazy" />
        <span class="min-w-0">
          <span class="block text-sm font-bold">{c.name}</span>
          <span class="mt-0.5 block truncate text-xs text-ink-2">{c.desc}</span>
        </span>
      </a>
    ))}
  </section>
</Base>
