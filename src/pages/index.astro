---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../site';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [first, ...rest] = posts;
const cats = [...new Set(posts.map((p) => p.data.category))];
---
<Base>
  <section class="mx-auto max-w-6xl px-5 pt-16 pb-10 md:pt-24">
    <p class="eyebrow">Food · Fact · Check</p>
    <h1 class="serif mt-4 max-w-3xl text-[2.4rem] font-bold leading-[1.15] md:text-[3.4rem]">{SITE.tagline}</h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-2">{SITE.description}</p>
    {cats.length > 0 && (
      <nav class="mt-8 flex flex-wrap gap-2">
        {cats.map((c) => (
          <a href={`/category/${c}`} class="rounded-full border border-line bg-white px-4 py-1.5 text-sm font-medium text-ink-2 hover:border-moss hover:text-moss">
            {SITE.categories[c] ?? c}
          </a>
        ))}
      </nav>
    )}
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-8">
    {posts.length === 0 ? (
      <p class="text-ink-2">아직 글이 없습니다.</p>
    ) : (
      <>
        <PostCard post={first} featured />
        {rest.length > 0 && (
          <div class="mt-14">
            <div class="mb-6 flex items-end justify-between">
              <h2 class="serif text-2xl font-bold">최신 글</h2>
              <a href="/rss.xml" class="text-sm text-ink-3 hover:text-moss">RSS</a>
            </div>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {rest.map((post) => <PostCard post={post} />)}
            </div>
          </div>
        )}
      </>
    )}
  </section>
</Base>
