---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, CATEGORIES } from '../site';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [first, ...rest] = posts;
const counts = posts.reduce((m, p) => ((m[p.data.category] = (m[p.data.category] ?? 0) + 1), m), {} as Record<string, number>);
---
<Base>
  <!-- 히어로 -->
  <section class="relative overflow-hidden border-b border-line">
    <img src="/img/hero.webp" alt="" class="absolute inset-0 h-full w-full object-cover object-right" fetchpriority="high" />
    <div class="absolute inset-0 bg-paper/85 md:bg-transparent md:bg-gradient-to-r md:from-paper md:via-paper/75 md:to-paper/10"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-20 md:py-32">
      <p class="eyebrow">Seasonal Seafood · Natural Ingredients</p>
      <h1 class="serif mt-4 max-w-2xl break-keep text-[2.4rem] font-bold leading-[1.12] md:text-[3.6rem]">{SITE.tagline}</h1>
      <p class="mt-5 max-w-lg text-lg leading-relaxed text-ink-2">{SITE.description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/guide" class="rounded-full bg-moss px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-moss-2">제철 수산·식재료 대도감</a>
        <a href="#latest" class="rounded-full border border-ink/15 bg-white/70 px-6 py-2.5 text-sm font-semibold text-ink backdrop-blur hover:bg-white">최신 글</a>
      </div>
    </div>
  </section>

  <!-- 분류 5개 -->
  <section class="mx-auto max-w-6xl px-5 pt-16">
    <div class="mb-6 flex items-end justify-between">
      <div>
        <p class="eyebrow">Categories</p>
        <h2 class="serif mt-2 text-2xl font-bold">무엇을 확인할까요</h2>
      </div>
      <a href="/guide" class="text-sm text-ink-3 hover:text-moss">전체 보기</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {Object.entries(CATEGORIES).map(([slug, c]) => (
        <a href={`/category/${slug}`} class="card group relative aspect-[4/5] overflow-hidden lg:aspect-[3/4]">
          <img src={c.image} alt="" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/20 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5 text-white">
            <p class="serif text-lg font-bold leading-tight">{c.name}</p>
            <p class="mt-1 text-xs text-white/75">{counts[slug] ?? 0}편</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 최신 글 -->
  <section id="latest" class="mx-auto max-w-6xl px-5 pt-20 pb-8 scroll-mt-20">
    <div class="mb-6 flex items-end justify-between">
      <div>
        <p class="eyebrow">Latest</p>
        <h2 class="serif mt-2 text-2xl font-bold">최신 글</h2>
      </div>
      <a href="/rss.xml" class="text-sm text-ink-3 hover:text-moss">RSS</a>
    </div>
    {posts.length === 0 ? (
      <p class="text-ink-2">아직 글이 없습니다.</p>
    ) : (
      <>
        <PostCard post={first} featured />
        {rest.length > 0 && (
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((post) => <PostCard post={post} />)}
          </div>
        )}
      </>
    )}
  </section>
</Base>
