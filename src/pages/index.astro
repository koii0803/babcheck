---
import { getPublished } from '../lib/posts';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import CategoryStrip from '../components/CategoryStrip.astro';
import { SITE } from '../site';
const posts = await getPublished();
const counts = posts.reduce((m, p) => ((m[p.data.category] = (m[p.data.category] ?? 0) + 1), m), {} as Record<string, number>);
// 히어로 회전: 최신 글 대표이미지(최대 5장) + 기본 풀 10장에서 총 10장. 글이 쌓이면 앞자리가 글 이미지로 바뀐다.
const heroPool = Array.from({ length: 10 }, (_, i) => `/img/hero/hero-${String(i + 1).padStart(2, '0')}.webp`);
const thumbs = posts.map((p) => p.data.thumbnail).filter((t): t is string => !!t).slice(0, 5);
const heroImgs = [...new Set([...thumbs, ...heroPool])].slice(0, 10);
const D = 7, F = 1.8, T = heroImgs.length * D; // 장당 7초, 겹침 전환 1.8초
const pct = (s: number) => +((s / T) * 100).toFixed(3);
// 히어로 문구 회전: 5종. 첫 번째만 h1(검색용), 나머지는 장식.
const heroCopy = [
  { h: '먹기 전에 한 번, 숫자로 확인', p: '제철 수산물과 천연 식재료, 먹기 전에 숫자로 확인합니다.' },
  { h: '몸에 좋다는 말 대신, 100g당 숫자', p: '효능 소문보다 식약처 영양성분 데이터를 먼저 봅니다.' },
  { h: '제철 밥상, 근거 있는 선택', p: '계절마다 오르는 재료를 공인 수치로 따져 고릅니다.' },
  { h: '같은 재료도 가공이 다르면 다른 음식', p: '생것과 말린 것, 청과 즙의 차이를 표로 비교합니다.' },
  { h: '오늘 재료의 진짜 값, 표로 확인', p: '단백질·나트륨·당류, 궁금한 숫자만 골라 봅니다.' },
];
const D2 = 7, F2 = 1.4, T2 = heroCopy.length * D2;
const pct2 = (s: number) => +((s / T2) * 100).toFixed(3);
const heroCss = `
.hero-slide{opacity:0;animation:heroFade ${T}s linear infinite;will-change:opacity,transform}
@keyframes heroFade{0%{opacity:0;transform:scale(1)}${pct(F)}%{opacity:1}${pct(D)}%{opacity:1}${pct(D + F)}%{opacity:0;transform:scale(1.06)}100%{opacity:0;transform:scale(1)}}
.hero-copy{grid-area:1/1;opacity:0;animation:copyFade ${T2}s linear infinite;will-change:opacity,transform}
@keyframes copyFade{0%{opacity:0;transform:translateY(10px)}${pct2(F2)}%{opacity:1;transform:none}${pct2(D2 - F2)}%{opacity:1;transform:none}${pct2(D2)}%{opacity:0;transform:translateY(-10px)}100%{opacity:0;transform:translateY(10px)}}
.btn-flow{background:linear-gradient(100deg,#0b5443,#0f6b55,#4c9877,#0f6b55,#0b5443);background-size:300% 100%;animation:btnFlow 5s ease-in-out infinite alternate}
@keyframes btnFlow{0%{background-position:0% 50%}100%{background-position:100% 50%}}
@media (prefers-reduced-motion:reduce){.hero-slide,.hero-copy,.btn-flow{animation:none}.hero-slide:first-child{opacity:1}.hero-copy:first-child{opacity:1}}
`;
---
<Base>
  <!-- 히어로 -->
  <section class="relative overflow-hidden border-b border-line">
    <style is:inline set:html={heroCss}></style>
    <div class="absolute inset-0" aria-hidden="true">
      {heroImgs.map((src, i) => (
        <img
          src={src}
          alt=""
          class="hero-slide absolute inset-0 h-full w-full object-cover object-right"
          style={`animation-delay:${i * D - F}s`}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
      ))}
    </div>
    <div class="absolute inset-0 bg-paper/85 md:bg-transparent md:bg-gradient-to-r md:from-paper md:via-paper/75 md:to-paper/10"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-14 md:py-32">
      <p class="eyebrow">Seasonal Seafood · Natural Ingredients</p>
      <div class="mt-4 grid">
        {heroCopy.map((c, i) => (
          <div class="hero-copy" style={`animation-delay:${i * D2 - F2}s`} aria-hidden={i === 0 ? undefined : 'true'}>
            {i === 0 ? (
              <h1 class="serif max-w-2xl break-keep text-[2.2rem] font-bold leading-[1.12] md:text-[3.6rem]">{c.h}</h1>
            ) : (
              <p class="serif max-w-2xl break-keep text-[2.2rem] font-bold leading-[1.12] md:text-[3.6rem]">{c.h}</p>
            )}
            <p class="mt-4 max-w-lg text-[1.05rem] leading-relaxed text-ink-2 md:text-lg">{c.p}</p>
          </div>
        ))}
      </div>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/guide" class="rounded-full bg-moss px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-moss-2">대도감</a>
        <a href="#latest" class="btn-flow rounded-full px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:brightness-110">최신 글</a>
      </div>
    </div>
  </section>

  <!-- 분류 -->
  <section class="mx-auto max-w-6xl px-5 pt-8 md:pt-16">
    <div class="mb-4 flex items-end justify-between md:mb-6">
      <h2 class="serif text-xl font-bold md:text-2xl">무엇을 확인할까요</h2>
      <a href="/guide" class="text-xs text-ink-3 hover:text-moss md:text-sm">전체 보기</a>
    </div>
    <CategoryStrip counts={counts} />
  </section>

  <!-- 최신 글: 앨범 격자 -->
  <section id="latest" class="mx-auto max-w-6xl scroll-mt-20 px-5 pb-8 pt-12 md:pt-20">
    <div class="mb-4 flex items-end justify-between md:mb-6">
      <h2 class="serif text-xl font-bold md:text-2xl">최신 글</h2>
      <a href="/rss.xml" class="text-xs text-ink-3 hover:text-moss md:text-sm">RSS</a>
    </div>
    {posts.length === 0 ? (
      <p class="text-ink-2">아직 글이 없습니다.</p>
    ) : (
      <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-6 lg:grid-cols-4">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    )}
  </section>
</Base>
