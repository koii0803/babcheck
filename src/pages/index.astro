---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../site';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const cats = [...new Set(posts.map((p) => p.data.category))];
---
<Base>
  <p class="text-neutral-600 mb-6">{SITE.description}</p>
  {cats.length > 0 && (
    <nav class="flex flex-wrap gap-2 mb-6 text-sm">
      {cats.map((c) => <a href={`/category/${c}`} class="rounded-full border px-3 py-1 hover:bg-neutral-100">{SITE.categories[c] ?? c}</a>)}
    </nav>
  )}
  {posts.length === 0 ? <p>아직 글이 없습니다.</p> : posts.map((post) => <PostCard post={post} />)}
</Base>
