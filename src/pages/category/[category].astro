---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE } from '../../site';
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((category) => ({
    params: { category },
    props: {
      posts: posts
        .filter((p) => p.data.category === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}
const { category } = Astro.params;
const { posts } = Astro.props;
const name = SITE.categories[category] ?? category;
---
<Base title={name} description={`${name} 글 모음`}>
  <section class="mx-auto max-w-6xl px-5 pt-14 md:pt-20">
    <p class="eyebrow">Category</p>
    <h1 class="serif mt-3 text-[2.2rem] font-bold md:text-[2.8rem]">{name}</h1>
    <p class="mt-3 text-ink-3">{posts.length}편</p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Base>
