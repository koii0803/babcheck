---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없습니다">
  <section class="mx-auto max-w-3xl px-5 pt-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="serif mt-3 text-[2.2rem] font-bold">이 주소엔 글이 없습니다</h1>
    <p class="mt-4 text-ink-2">지워졌거나 주소가 바뀌었을 수 있습니다.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-moss px-6 py-2.5 text-sm font-semibold text-white hover:bg-moss-2">홈으로</a>
  </section>
</Base>
