---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../site';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
}
const { title, description = SITE.description, image, type = 'website', pubDate, updatedDate } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''), Astro.site);
const ogImage = new URL(image ?? SITE.ogImage, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="msvalidate.01" content="BCA1153B9BBD880133980FB089BDA229" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="theme-color" content="#faf8f3" />
    <!-- 다크모드: 저장값(localStorage.theme) 없으면 OS 설정. 깜빡임 막으려고 head에서 먼저 적용 -->
    <script is:inline>
      (function () {
        function apply() {
          var saved = localStorage.getItem('theme');
          var dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', dark ? '#191816' : '#faf8f3');
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
        document.addEventListener('astro:page-load', function () {
          var b = document.getElementById('theme-toggle');
          if (!b) return;
          b.onclick = function () {
            var dark = !document.documentElement.classList.contains('dark');
            localStorage.setItem('theme', dark ? 'dark' : 'light');
            apply();
          };
        });
      })();
    </script>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {type === 'article' && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {type === 'article' && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <!-- Google AdSense 사이트 연결 코드 -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9894057521045935" crossorigin="anonymous"></script>
    <!-- Google Analytics 4 (GA4). ClientRouter 페이지 전환마다 page_view 전송 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QXS81ZWYLT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QXS81ZWYLT', { send_page_view: false });
      document.addEventListener('astro:page-load', () => {
        gtag('event', 'page_view', { page_location: location.href, page_title: document.title });
      });
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 border-b border-line/80 bg-paper/85 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
        <a href="/" class="flex items-center gap-1.5">
          <span class="logo text-[1.9rem] leading-none">{SITE.title}</span>
          <svg viewBox="0 0 24 24" class="h-[1.05rem] w-[1.05rem] -translate-y-[1px] text-moss" fill="none" aria-hidden="true">
            <path d="M4.5 13.5l4.5 4.5L19.5 6.5" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <nav class="flex items-center gap-1 text-[0.95rem] font-medium text-ink-2">
          <a href="/guide" class="rounded-full px-3.5 py-1.5 hover:bg-paper-2 hover:text-ink">대도감</a>
          <a href="/about" class="rounded-full px-3.5 py-1.5 hover:bg-paper-2 hover:text-ink">소개</a>
          <a href="/contact" class="rounded-full px-3.5 py-1.5 hover:bg-paper-2 hover:text-ink">문의</a>
          <button id="theme-toggle" type="button" aria-label="다크모드 전환" class="ml-1 grid h-9 w-9 place-items-center rounded-full hover:bg-paper-2 hover:text-ink">
            <svg viewBox="0 0 24 24" class="h-[1.1rem] w-[1.1rem] dark:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
            <svg viewBox="0 0 24 24" class="hidden h-[1.1rem] w-[1.1rem] dark:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-line bg-paper-2/60">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <p class="logo flex items-center gap-1 text-[1.7rem]">
            {SITE.title}
            <svg viewBox="0 0 24 24" class="h-[0.85rem] w-[0.85rem] text-moss" fill="none" aria-hidden="true">
              <path d="M4.5 13.5l4.5 4.5L19.5 6.5" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </p>
          <p class="mt-3 max-w-sm text-[0.95rem] leading-relaxed text-ink-2">{SITE.description}</p>
          <p class="mt-4 text-sm text-ink-3">여기 글은 일반 정보이며 진단·처방을 대신하지 않습니다.</p>
        </div>
        <div>
          <p class="eyebrow">둘러보기</p>
          <ul class="mt-4 space-y-2.5 text-[0.95rem] text-ink-2">
            <li><a href="/" class="hover:text-moss">최신 글</a></li>
            <li><a href="/guide" class="hover:text-moss">대도감</a></li>
            <li><a href="/about" class="hover:text-moss">소개</a></li>
            <li><a href="/contact" class="hover:text-moss">문의</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">안내</p>
          <ul class="mt-4 space-y-2.5 text-[0.95rem] text-ink-2">
            <li><a href="/privacy" class="hover:text-moss">개인정보처리방침</a></li>
            <li><a href="/disclaimer" class="hover:text-moss">면책 조항</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-line">
        <div class="mx-auto max-w-6xl px-5 py-5 text-xs text-ink-3">© {year} {SITE.title}. All rights reserved.</div>
      </div>
    </footer>
  </body>
</html>
